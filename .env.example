# ==============================================================================
# DOCKER & ORQUESTRAÇÃO
# ==============================================================================
# Isola o projeto no Docker (ex: financial, financial-homolog)
COMPOSE_PROJECT_NAME=financial

# Profiles disponíveis:
# - app,db : Sobe banco local postgres + api + frontend
# - app    : Conecta em banco externo, sobe apenas api + frontend
COMPOSE_PROFILES=app,db

# IP de escuta no host (127.0.0.1 para seguro local, 0.0.0.0 para expor na LAN/servidor)
HOST_BIND_IP=127.0.0.1

# Fuso horário padrão da aplicação e banco de dados
TZ=America/Sao_Paulo

# Ambiente (development | staging | production)
APP_ENV=development

# ==============================================================================
# BANCO DE DADOS (PostgreSQL) - Defina credenciais fortes obrigatórias
# ==============================================================================
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=substitua_por_uma_senha_forte_de_banco
DB_NAME=financial_db
DB_PORT=5432
PGDATA_PATH=./pgdata

# ==============================================================================
# BACKEND API (NestJS)
# ==============================================================================
# Porta externa no Host (onde a API responderá)
API_PORT=3001

# Chave JWT obrigatória com no mínimo 32 caracteres seguros (ex: openssl rand -base64 32)
JWT_SECRET=substitua_por_uma_chave_secreta_com_minimo_32_caracteres_aleatorios
JWT_EXPIRATION=1d

# Origens CORS autorizadas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Desabilitar cadastro público de novos usuários (true para desativar, false para permitir)
DISABLE_REGISTRATION=false

# ==============================================================================
# FRONTEND WEB (Next.js)
# ==============================================================================
# Porta externa no Host (onde a aplicação Web responderá)
FRONTEND_PORT=3000

# URL pública que o navegador do cliente usará para consultar a API
# NOTA: Ao alterar esta URL, execute: docker compose up -d --build frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
