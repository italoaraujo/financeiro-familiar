# Docker Compose Config
# Isola o projeto no Docker (ex: financial, financial-homolog)
COMPOSE_PROJECT_NAME=financial

# Docker Compose Profiles:
# - Sobe banco local + apps: COMPOSE_PROFILES=app,db
# - Usa banco externo, sobe apenas apps: COMPOSE_PROFILES=app
COMPOSE_PROFILES=app,db

# Environment (development | staging | production)
APP_ENV=development

# Database (Local / Container) - Defina credenciais fortes obrigatórias
DB_HOST=${COMPOSE_PROJECT_NAME}-postgres
DB_USER=postgres
DB_PASSWORD=substitua_por_uma_senha_forte_de_banco
DB_NAME=${COMPOSE_PROJECT_NAME}_db
DB_PORT=5432
PGDATA_PATH=./pgdata

# Backend API
PORT=3001
# Chave JWT obrigatória com no mínimo 32 caracteres seguros
JWT_SECRET=substitua_por_uma_chave_secreta_com_minimo_32_caracteres_aleatorios
JWT_EXPIRATION=1d
# Origens CORS autorizadas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Desabilitar cadastro público de novos usuários (true para desativar, false para permitir)
DISABLE_REGISTRATION=false

# Frontend Web
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

