# URL base da API REST do Backend (NestJS)
MCP_API_URL=http://localhost:3001

# Opção 1 (Recomendada): Token de acesso gerado na tela web "/mcp" (Integração IA)
MCP_API_TOKEN=

# Opção 2 (Fallback): Credenciais de login caso MCP_API_TOKEN não seja informado
MCP_USER_EMAIL=admin@exemplo.com
MCP_USER_PASSWORD=123456

# Contexto Familiar Padrão (opcional — UUID da família; se vazio, usa visão Pessoal por padrão)
MCP_DEFAULT_FAMILY_ID=

# Timeout das requisições HTTP para a API em milissegundos
MCP_HTTP_TIMEOUT_MS=15000
